# Vector-ARC Environment Configuration
# Copy this file to .env and fill in your API key to run the system.

# The LLM Provider to use (groq, siliconflow, openai, etc.)
LLM_PROVIDER=groq

# Your API Key (Get a free one at https://console.groq.com)
LLM_API_KEY=YOUR_API_KEY_HERE

# The Model to use (must be supported by your chosen provider)
LLM_MODEL=llama-3.3-70b-versatile
